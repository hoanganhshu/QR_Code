<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/framecamera"
        android:layout_width="@dimen/_204sdp"
        android:layout_height="@dimen/_204sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="72dp"
        app:layout_constraintEnd_toEndOf="parent">



        <androidx.cardview.widget.CardView
            android:id="@+id/cardCamera"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/_2sdp"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardUseCompatPadding="true">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:keepScreenOn="true"
                app:implementationMode="performance" />
        </androidx.cardview.widget.CardView>


        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/corner"
            android:scaleType="fitXY"
            android:clickable="false"
            android:focusable="false" />
        <View
            android:id="@+id/scanLine"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/_7sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:background="#4CE4C1" />

    </FrameLayout>


    <com.google.android.material.slider.Slider
        android:id="@+id/slider"
        android:layout_width="@dimen/_200sdp"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_72sdp"
        app:layout_constraintTop_toBottomOf="@+id/framecamera"
        />
    <ImageView
        android:layout_width="@dimen/_15sdp"
       app:layout_constraintStart_toEndOf="@+id/slider"
        app:layout_constraintTop_toTopOf="@+id/slider"
        app:layout_constraintBottom_toBottomOf="@id/slider"



        android:layout_height="@dimen/_15sdp"

        android:layout_marginStart="@dimen/_10sdp"
        android:src="@drawable/minus"
        android:id="@+id/minus"

        />
    <ImageView
        android:layout_width="@dimen/_15sdp"
        app:layout_constraintTop_toTopOf="@+id/slider"
        app:layout_constraintBottom_toBottomOf="@id/slider"

        app:layout_constraintEnd_toStartOf="@+id/slider"


        android:layout_height="@dimen/_15sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:src="@drawable/plus"

        android:id="@+id/plus"

        />





    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/_244sdp"
        app:layout_constraintTop_toBottomOf="@+id/slider"
        android:layout_height="@dimen/_40sdp"

        android:id="@+id/cardView"
        android:layout_marginTop="@dimen/_24sdp"
        app:cardCornerRadius="@dimen/_13sdp"
        android:backgroundTint="@color/base"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        >
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="@dimen/_55sdp"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/_24sdp"
                android:id="@+id/choseimage"
                android:src="@drawable/photoimage"


                />
            <ImageView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/_24sdp"
                android:id="@+id/rotateimage"
                android:layout_marginHorizontal="@dimen/_36sdp"
                android:src="@drawable/rotatecamera"

                />
            <ImageView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/_24sdp"
                android:id="@+id/flash"
                android:src="@drawable/flash"

                />

        </LinearLayout>




    </com.google.android.material.card.MaterialCardView>



</androidx.constraintlayout.widget.ConstraintLayout>
