<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    tools:context=".view.HistoryFragment">
    
    <FrameLayout
        android:layout_width="match_parent"
        android:id="@+id/appbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/base"
        android:layout_height="@dimen/_140sdp"
        >
        <ImageView
            android:layout_width="@dimen/_204sdp"
            android:layout_height="@dimen/_204sdp"
            android:translationX="-106dp"

            android:translationY="-137dp"

            android:layout_gravity="start"
            android:src="@drawable/test"
            />
        <ImageView
            android:layout_width="@dimen/_12sdp"
            android:layout_height="@dimen/_12sdp"
            android:layout_marginStart="@dimen/_111sdp"
            android:layout_marginTop="@dimen/_67sdp"
            android:layout_gravity="start"
            android:src="@drawable/test"
            />
        <ImageView
            android:layout_width="@dimen/_62sdp"
            android:layout_height="@dimen/_62sdp"
            android:translationX="-38dp"
            android:translationY="-38dp"
            android:layout_gravity="end"
            android:src="@drawable/test"
            />
        <ImageView
            android:layout_width="@dimen/_143sdp"
            android:layout_height="@dimen/_115sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_26sdp"
            android:layout_gravity="end"
            android:src="@drawable/decor"
            />
        <ImageView
            android:layout_width="24dp"
            android:id="@+id/generate"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/_29sdp"
            android:layout_marginStart="@dimen/_23sdp"
            android:src="@drawable/addvector"
            />
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/_29sdp"
            android:layout_marginEnd="@dimen/_23sdp"
            android:src="@drawable/editvector"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppin_family"
            android:textSize="@dimen/_12sdp"
            android:text="@string/history_title"
            android:layout_marginTop="@dimen/_65sdp"
            android:layout_marginStart="@dimen/_24sdp"
            android:textColor="@color/white"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppin_family"
            android:textSize="@dimen/_20sdp"
            android:text="@string/history_subtitle"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/_87sdp"
            android:layout_marginStart="@dimen/_24sdp"
            android:textColor="@color/white"
            />





    </FrameLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textColor="#B4B7CC"
        android:textSize="@dimen/_17sdp"
        android:fontFamily="@font/poppin_family"
        android:id="@+id/subtitle"
        android:visibility="gone"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/_28sdp"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toTopOf="@id/scannow"
        android:layout_marginBottom="@dimen/_25sdp"
        android:text="@string/emptyhistory"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"

        android:backgroundTint="@color/base"
        app:cardCornerRadius="@dimen/_13sdp"
        android:id="@+id/scannow"
      android:layout_marginHorizontal="@dimen/_24sdp"

        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_24sdp"
            android:id="@+id/tvscannow"
            android:text="@string/scannow"
            android:fontFamily="@font/poppin_family"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="@dimen/_16sdp"
            />


    </androidx.cardview.widget.CardView>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="40dp"
        android:id="@+id/item_day_history"
        android:clipToPadding="false"
        android:layout_marginEnd="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appbar"
        android:paddingBottom="120dp"
        android:layout_marginTop="@dimen/_30sdp"
        />

 

</androidx.constraintlayout.widget.ConstraintLayout>