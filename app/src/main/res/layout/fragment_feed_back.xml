<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".view.FeedBackFragment">
    <ImageView
        android:layout_width="@dimen/_24sdp"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="@dimen/_24sdp"
        android:id="@+id/btnback"
        android:layout_marginStart="@dimen/_24sdp"
        android:src="@drawable/btnback"
        android:elevation="@dimen/_2sdp"
        android:layout_marginTop="29dp"


        />

    <TextView
        android:layout_width="match_parent"
        android:text="@string/feeaback"
        android:textStyle="bold"
        android:fontFamily="@font/poppin_family"
        android:id="@+id/feedback"
        android:background="@color/base"
        android:textColor="@color/white"
        android:textSize="@dimen/_18sdp"

        android:paddingTop="29dp"

        android:gravity="center_horizontal"
        android:layout_height="78dp"
        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        />
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toBottomOf="@+id/feedback"
        android:minHeight="@dimen/_150sdp"
        android:id="@+id/inputtetx"
        android:layout_marginTop="80dp"
        android:layout_marginHorizontal="@dimen/_40sdp"
        app:layout_constraintStart_toStartOf="parent"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="15dp"

        >
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="15dp"

            app:boxBackgroundMode="none">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/input"

                android:background="@null"/>
        </com.google.android.material.textfield.TextInputLayout>



    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/inputtetx"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"
        android:background="@color/base"
        app:cardCornerRadius="15dp"
        android:backgroundTint="@color/base"
        app:strokeWidth="1dp"
        app:strokeColor="#E0E0E0"
        android:layout_marginHorizontal="@dimen/_80sdp"


        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/sendfeeback"
            android:id="@+id/sendfeed"
            android:fontFamily="@font/poppin_family"
            android:textStyle="bold"
            android:gravity="center"

            android:textColor="@color/white"


            />
    </com.google.android.material.card.MaterialCardView>



</androidx.constraintlayout.widget.ConstraintLayout>