<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:paddingTop="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="2dp"
            app:strokeColor="#CDD0E3"
            app:cardCornerRadius="@dimen/_15sdp">

            <!-- ========== VIEW SWITCHER ========== -->
            <ViewSwitcher
                android:id="@+id/viewSwitcher"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- ========== LAYOUT 1 (bạn gửi) ========== -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imageicon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="28dp"
                        android:layout_marginTop="15dp"
                        android:src="@drawable/icon_phone"/>

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="80dp"
                        android:layout_marginTop="13dp"
                        android:text="@string/name_example"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="13dp"/>

                    <TextView
                        android:id="@+id/subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="80dp"
                        android:layout_marginTop="34dp"
                        android:text="@string/name_example"
                        android:textColor="#B4B7CC"
                        android:textSize="11dp"/>

                    <ImageView
                        android:id="@+id/threedot"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/_19sdp"
                        android:layout_marginEnd="@dimen/_24sdp"
                        android:src="@drawable/three_dots"/>
                </FrameLayout>

                <!-- ========== LAYOUT 2 (4 actions) ========== -->
                <LinearLayout
                    android:id="@+id/layoutActions"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"

                    android:gravity="center"
                    android:weightSum="4">

                    <!-- CLOSE -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:id="@+id/close"
                        android:gravity="center"
                        android:background="#E6E7F1"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/close"/>
                    </LinearLayout>

                    <!-- EDIT -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:id="@+id/edit"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/edit_item"
                            android:layout_marginTop="9dp"/>

                        <TextView
                            android:text="@string/edit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10dp"
                            android:textColor="#3C52F5"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- SHARE -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:id="@+id/share"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/share_item"
                            android:layout_marginTop="9dp"/>

                        <TextView
                            android:text="@string/share"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10dp"
                            android:textColor="#3C52F5"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- DELETE -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:id="@+id/delete"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/delete"
                            android:layout_marginTop="9dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/delete"
                            android:textSize="10dp"
                            android:textColor="#EB5757"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                </LinearLayout>

            </ViewSwitcher>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
