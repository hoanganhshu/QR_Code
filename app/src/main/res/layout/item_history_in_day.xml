<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginRight="15dp"

    >
    <ViewSwitcher
        android:id="@+id/viewSwitcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/_127sdp"
            app:strokeColor="#B4B7CC"
            app:strokeWidth="1dp"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="@dimen/_15sdp"
            android:layout_height="@dimen/_149sdp"

            >


            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/icon_phone"
                android:id="@+id/icon_phone_front"
                android:layout_marginStart="12dp"
                android:layout_marginTop="18dp"
                />


            <FrameLayout

                android:layout_width="36dp"
                android:layout_height="36dp"
                android:id="@+id/two_dots"

                android:layout_marginStart="@dimen/_91sdp"
                android:layout_marginTop="@dimen/_11sdp"


                >


                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/circleImage"
                    android:src="@drawable/two_dot"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Circle"
                    android:scaleType="centerCrop"/>


                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:id="@+id/select"
                    android:layout_gravity="center"

                    android:scaleType="fitCenter"/>
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppin_family"
                android:textStyle="bold"
                android:id="@+id/title"
                android:textSize="@dimen/_13sdp"
                android:text="@string/name_example"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_50sdp"

                />
            <View
                android:layout_width="@dimen/_103sdp"
                android:layout_height="@dimen/_1sdp"
                android:background="#CDD0E3"
                android:layout_marginTop="@dimen/_91sdp"
                android:layout_marginStart="@dimen/_12sdp"

                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_16sdp"
                android:fontFamily="@font/poppin_family"
                android:textSize="@dimen/_10sdp"
                android:text="@string/createdin"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_100sdp"

                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_16sdp"
                android:id="@+id/createIn"
                android:fontFamily="@font/poppin_family"

                android:textSize="@dimen/_11sdp"
                android:text="@string/createdin"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_117sdp"

                />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/_127sdp"
            app:strokeColor="#B4B7CC"
            android:paddingTop="10dp"
            android:layout_marginEnd="12dp"



            app:cardCornerRadius="@dimen/_15sdp"
            android:layout_height="@dimen/_149sdp"

            >
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/icon_phone"
                android:id="@+id/icon_phone_back"
                android:layout_marginStart="12dp"
                android:layout_marginTop="20dp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:text="@string/name_example"
                android:textColor="@color/black"
                android:textSize="17dp"
                android:textStyle="bold"
                android:layout_marginTop="27dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="55dp"


                />
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginTop="70dp"
                android:background="#CDD0E3"
                android:layout_marginHorizontal="12dp"


                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share"
                android:layout_marginTop="80dp"
                android:id="@+id/share"

                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:textSize="15dp"
                android:textColor="@color/black"
                />
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginTop="110dp"
                android:background="#CDD0E3"
                android:layout_marginHorizontal="12dp"


                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="120dp"
                android:id="@+id/delete"

                android:text="@string/delete"
                android:textColor="@color/red"


                />
        </com.google.android.material.card.MaterialCardView>
        
        
        
        
        
    </ViewSwitcher>

   
    


</androidx.constraintlayout.widget.ConstraintLayout>
</layout>