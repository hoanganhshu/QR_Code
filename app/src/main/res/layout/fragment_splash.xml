<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/base"
    tools:context="view.SplashFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">



        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/test"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="378dp"
            android:layout_marginTop="499dp"
            tools:layout_editor_absoluteX="378dp"
            tools:layout_editor_absoluteY="499dp" />

        <ImageView
            android:id="@+id/imageView1"
            android:layout_width="204dp"
            android:layout_height="204dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="253dp"
            android:layout_marginTop="-59dp"
            android:src="@drawable/test"
            tools:layout_editor_absoluteX="253dp"
            tools:layout_editor_absoluteY="-59dp" />

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="296dp"
            android:layout_marginTop="164dp"
            android:src="@drawable/test"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/test"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="-16dp"
            android:layout_marginTop="116dp"
            tools:layout_editor_absoluteX="-16dp"
            tools:layout_editor_absoluteY="116dp" />

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="334dp"
            android:layout_height="334dp"
            android:src="@drawable/test"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="-98dp"
            android:layout_marginTop="561dp"
            tools:layout_editor_absoluteX="-98dp"
            tools:layout_editor_absoluteY="561dp" />
        <ImageView
            android:id="@+id/imageqr"
            android:layout_width="153dp"
            android:layout_height="165dp"
            android:background="@drawable/qr_patern"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/discover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/discover"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/poppin_family"
            android:layout_marginStart="-20dp"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/imageqr"
            app:layout_constraintTop_toBottomOf="@+id/imageqr"

            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/qrscan"
            android:textSize="22sp"
            android:fontFamily="@font/poppin_family"
            android:textColor="#4CE4C1"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toEndOf="@+id/discover"
            app:layout_constraintTop_toBottomOf="@+id/imageqr"

            />

    </androidx.constraintlayout.widget.ConstraintLayout>


</FrameLayout>