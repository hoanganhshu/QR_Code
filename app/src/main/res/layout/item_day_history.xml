<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
>
    
    
    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/circlehistory"
        android:id="@+id/circle_history"
        
        />
    
    <View
        android:layout_width="@dimen/_1sdp"
        android:layout_height="@dimen/_74sdp"
        android:background="#CDD0E3"
        android:id="@+id/view1"
        android:layout_marginTop="@dimen/_8sdp"

        app:layout_constraintTop_toBottomOf="@+id/circle_history"
        app:layout_constraintStart_toStartOf="@id/circle_history"
        android:layout_marginStart="11dp"
        />
    
    <ImageView
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="@dimen/_19sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:src="@drawable/decor_add"
        android:padding="@dimen/_5sdp"
        android:background="#B4B7CC"
        app:layout_constraintTop_toBottomOf="@id/view1"
        android:layout_marginBottom="@dimen/_8sdp"
        android:id="@+id/decor_add"
        android:layout_height="@dimen/_24sdp">



    </ImageView>
    <View
        android:layout_width="@dimen/_1sdp"
        android:layout_height="@dimen/_74sdp"
        android:background="#CDD0E3"
        android:id="@+id/view2"
        android:layout_marginTop="@dimen/_8sdp"

        app:layout_constraintTop_toBottomOf="@+id/decor_add"
        app:layout_constraintStart_toStartOf="@id/decor_add"
        android:layout_marginStart="11dp"
        />


    <TextView
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="wrap_content"
        android:fontFamily="@font/poppin_family"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/circle_history"
        android:text="@string/createdin"
        android:id="@+id/day_history"
        android:textColor="#B4B7CC"
        android:textSize="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_16sdp"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toBottomOf="@id/day_history"
        android:fontFamily="@font/poppin_family"
        app:layout_constraintStart_toStartOf="@id/day_history"
        android:text="@string/createdin"
        android:id="@+id/createin"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="@dimen/_13sdp"

        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_item_history_in_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="@id/createin"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_history_in_day"
        app:layout_constraintTop_toBottomOf="@id/createin"
        />


</androidx.constraintlayout.widget.ConstraintLayout>
</layout>